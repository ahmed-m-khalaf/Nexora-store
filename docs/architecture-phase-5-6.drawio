        </mxCell>
        <mxCell id="banner-p5-fe" parent="swimlane-frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E40AF;fontStyle=1;fontSize=13;" value="PHASE 5: DB-Driven Product Catalog" vertex="1">

<mxfile host="app.diagrams.net" agent="Antigravity AI">
  <diagram id="phase56-architecture" name="Nexora Store - Phase 5 &amp; 6 Architecture">
    <mxGraphModel dx="1271" dy="669" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" background="#ffffff" math="0" shadow="0">
